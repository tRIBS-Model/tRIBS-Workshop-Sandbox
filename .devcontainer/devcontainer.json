{
  "name": "tRIBS Class Sandbox",
  // Prebuilt by .github/workflows/build-devcontainer-image.yml from
  // ./Dockerfile, which remains the source of truth. Creating a codespace is a
  // pull, not a build, edits to Dockerfile take effect only once that
  // workflow republishes the image. On main this should read ":latest".
  "image": "ghcr.io/tribs-model/tribs-workshop-sandbox:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        // The image's Python, where pytRIBS and ipykernel are installed.
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        // The Jupyter extension only auto-selects a kernel when a single
        // interpreter is a candidate. Exclude Debian's system Python.
        "jupyter.kernels.excludePythonEnvironments": [
          "/usr/bin/python3",
          "/usr/bin/python3.13",
          "/bin/python3"
        ]
      }
    }
  }
}
